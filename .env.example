# Copy to .env and adjust. Load it with:  set -a; source .env; set +a
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///data/spm.db
# PostgreSQL (docker compose / Neon / Supabase):
# DATABASE_URL=postgresql://spm:spm@localhost:5432/spm

SPM_REQUEST_DELAY=1.0
SPM_MIN_PRICE_CHANGE_PCT=0
SPM_SITEWIDE_SALE_THRESHOLD=0.25

# Public demo limits
SPM_DEMO_MAX_PAGES=4
SPM_DEMO_MAX_ANALYSES=10
SPM_DEMO_ALLOW_TRACKING=false
